// --- 3. LST CALCULATION LOGIC ---

// Visualization parameters for the LST thermal layer (Celsius)
var lstVis = {
  min: 15,
  max: 45,
  palette: [
    'blue', 'cyan', 'green', 'yellow', 'orange', 'red'
  ]
};

// Function to compute LST for a chosen geometry using Landsat 8 Top of Atmosphere (TOA)
function computeLST(geometry) {
  // Filter Landsat 8 collection to the target area during summer months
  var collection = ee.ImageCollection('LANDSAT/LC08/C02/T1_TOA')
    .filterBounds(geometry)
    .filterDate('2023-01-01', '2023-12-31')
    .filter(ee.Filter.lt('CLOUD_COVER', 15));
    
  if (collection.size().getInfo() === 0) {
    return null;
  }
  
  // Median composite to create a cloud-free single image base
  var image = collection.median();
  
  // Landsat 8 Band 10 is Thermal Infrared 1 (TIR-1).
  // Formula to convert TOA Brightness Temperature from Kelvin to Celsius: C = K - 273.15
  var thermalBand = image.select('B10');
  var lstCelsius = thermalBand.subtract(273.15).rename('LST_Celsius');
  
  return lstCelsius.clip(geometry);
}


// --- 4. MAP UTILITIES & ACTION TRIGGER ---

// Set up default map behavior
Map.setControlVisibility({all: true});
Map.style().set('cursor', 'crosshair');

// Define click trigger on the interactive button
runButton.onClick(function() {
  var selectedRegion = regionSelect.getValue();
  
  if (!selectedRegion) {
    statusLabel.setValue('Error: Please select a valid region first!');
    return;
  }
  
  statusLabel.setValue('Processing calculation... please wait.');
  
  var geometry = aois[selectedRegion];
  
  // Center map dynamically onto the chosen AOI
  Map.centerObject(geometry, 11);
  
  // Calculate LST layer
  var lstLayer = computeLST(geometry);
  
  if (lstLayer) {
    // Clear any previous layers to prevent overlap stack cluttering
    Map.layers().reset();
    
    // Add calculated layer to Map panel
    Map.addLayer(lstLayer, lstVis, 'Land Surface Temperature (Celsius) - ' + selectedRegion);
    
    // Generate a static download URL to simulate data exporter requirement
    var downloadUrl = lstLayer.getDownloadURL({
      name: 'LST_' + selectedRegion.replace(' ', '_'),
      scale: 30,
      region: geometry.bounds()
    });
    
    statusLabel.setValue('Success! Map updated.');
    
    // Provide user with data exporter text link
    print('Download link for ' + selectedRegion + ' GeoTIFF:', downloadUrl);
  } else {
    statusLabel.setValue('Error: No clear satellite data found for this region.');
  }
});
