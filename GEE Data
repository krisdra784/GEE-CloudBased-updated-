// --- 3. DATASET FILTERING & LST CALCULATION LOGIC ---
// Visual palette for thermal mapping
var lstVis = {
  min: 10,
  max: 40,
  palette: ['blue', 'cyan', 'green', 'yellow', 'orange', 'red']
};

// Target Location: Melbourne coordinates
var melbourneGeometry = ee.Geometry.Polygon([
  [[144.5, -38.2], [145.5, -38.2], [145.5, -37.5], [144.5, -37.5]]
]);

function processMelbourneLST() {
  statusLabel.setValue('Fetching Aqua MODIS Dataset...');
  
  // i, iii, iv. Load Aqua 8-Day Global 1km and select Day Land Surface Temperature band
  var dataset = ee.ImageCollection('MODIS/061/MYD11A2')
    .filterBounds(melbourneGeometry)
    .filterDate('2020-01-01', '2020-12-31') // Adjust to your preferred time window
    .select('LST_Day_1km');
    
  // vi. Convert raw values to Celsius and compute median composite
  // MODIS LST digital numbers must be multiplied by a scale factor of 0.02, then subtract 273.15
  var medianLST = dataset.median().clip(melbourneGeometry);
  var lstCelsius = medianLST.multiply(0.02).subtract(273.15).rename('LST_Celsius');
  
  return lstCelsius;
}

// --- 4. MAP UTILITIES & FRONTEND EVENT HANDLER ---
Map.centerObject(melbourneGeometry, 9);

runButton.onClick(function() {
  statusLabel.setValue('Computing median composite...');
  
  // vii. Visualize results on the map panel
  var finalLayer = processMelbourneLST();
  
  Map.layers().reset();
  Map.addLayer(finalLayer, lstVis, 'Melbourne Median LST (Celsius) - 2020');
  
  // Data exporter link generation
  var downloadUrl = finalLayer.getDownloadURL({
    name: 'Melbourne_LST_MODIS',
    scale: 1000,
    region: melbourneGeometry
  });
  
  statusLabel.setValue('Success! Map updated.');
  print('Data Exporter Link (GeoTIFF):', downloadUrl);
});
